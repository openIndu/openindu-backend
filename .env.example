# Required: generate local-only values; never reuse production credentials.
POSTGRES_PASSWORD=
DATABASE_URL=

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=http://minio:9000
OSS_BUCKET=openindu
OSS_REGION=us-east-1

# Internal MinIO credentials used only by local Docker Compose.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=plc_knowledge
EMBEDDING_MODEL=BAAI/bge-m3

# IP geo resolution (ip2region offline xdb). Relative paths resolve against the
# backend root; leave as-is unless the xdb lives elsewhere.
IP2REGION_XDB_PATH=data/ip2region_v4.xdb

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

SMS_ACCESS_KEY=
SMS_TEMPLATE_ID=
# Separate Aliyun template for the member-approval notification (register it
# in the Aliyun SMS console first). Leave empty until the template CODE exists.
SMS_APPROVAL_TEMPLATE_ID=
SMS_MOCK_ENABLED=true
SMS_MOCK_CODE=888888

MCP_API_KEY=change-me-mcp-key
WEB_PORT=8004
MCP_PORT=8005

DOWNLOAD_DAILY_LIMIT=5
PRESIGNED_URL_EXPIRE_MINUTES=5
DOCUMENT_MAX_SIZE_MB=50
SOFTWARE_MAX_SIZE_GB=5
