[run]
branch = True
source = app
omit =
    # External service integrations that require actual external services
    app/mcp/*
    app/mcp_app.py
    app/shared/services/oss_service.py
    app/shared/middleware/*
    app/web_app.py
    # FastAPI route wrappers that just delegate to the identity context
    app/api/auth.py
    # FastAPI dependencies that need running request context
    app/shared/core/dependencies.py
    # Portal endpoints that need more complex mocking for full coverage
    app/api/portal.py

[report]
fail_under = 80
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
